+    def __sample_periodic_poly(self, magnitude: torch.Tensor, direction: torch.Tensor) -> torch.Tensor:
+        parameters = self.__poly_grad[:, magnitude, direction]
+        # The calibration includes both -pi and +pi. They describe the same
+        # orientation but independent fitted coefficients can differ. Average
+        # these endpoint estimates so the new lookup is continuous at the seam.
