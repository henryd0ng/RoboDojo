     from ..uipc_object import UipcObject
 
 
+def _target_dtype(value):
+    if type(value) is not str or value not in {"float32", "float64"}:
+        raise ValueError("Attachment target_dtype must be 'float32' or 'float64'")
+    return torch.float64 if value == "float64" else torch.float32
+
+
+def _unit_quaternion(quaternion):
+    norm = torch.linalg.vector_norm(quaternion, dim=-1, keepdim=True)
+    if not torch.isfinite(quaternion).all() or not torch.isfinite(norm).all() or (norm <= 1e-12).any():
+        raise ValueError("Float64 attachment quaternion must be finite and nonzero")
+    return quaternion / norm
+
